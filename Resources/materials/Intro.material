material Intro/Background
{
    technique
    {
        pass
        {
            texture_unit{
                texture ZAPASCAPE.png
                filtering none
            }
        }
    }
}
material Intro/StartButton
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend

            texture_unit{
                texture buttonPlay.png
            }
        }
    }
}

material Intro/StartButtonOnHover
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend

            texture_unit{
                texture buttonPlayHover.png
                colour_op replace
            }
        }
    }
}

material Intro/ExitButton
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend

            texture_unit{
                texture buttonExit.png
            }
        }
    }
}

material Intro/ExitButtonOnHover
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend

            texture_unit{
                texture buttonExitHover.png
                colour_op replace
            }
        }
    }
}