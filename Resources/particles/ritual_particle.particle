particle_system Particle/RitualParticle
{
    quota           1000
    particle_width      0.1
    particle_height     0.1
    sorted              true
    renderer        billboard

    emitter Box {
        position 0 -0.4 0
        direction 0 1 0
        angle 45 
        duration 0
        emission_rate 4 
        time_to_live_min 5.0
        time_to_live_max 10.0
        width  2.5
        height 1
        depth  2.5
        velocity_min 0.01
        velocity_max 0.1
    }
    affector Scaler {
        rate 0.25
    }
    affector ColourFader {
        red   -0.05
        green -0.05
        blue  -0.05
        alpha -0.2
    }
}

particle_system Particle/Star
{
    billboard_type      point
    particle_width      0.1
    particle_height     0.1
    quota               10
    sorted              true

    emitter Point {
        position 0 -0.05 0
        direction 0 1 0
        angle 60 
        colour 0.0 0.0 1.0 1.0
        duration 0
        emission_rate 3  
        time_to_live_min 1.0
        time_to_live_max 2.0
        velocity_min 0.2
        velocity_max 1.0
    }
    affector ColourFader
    {
        red -0.5
        green -0.5
        blue 0
    }
}