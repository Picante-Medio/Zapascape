particle_system Particle/RitualParticle
{
    quota           1000
    material        Particle/ImageMaterial
    particle_width      0.06
    particle_height     0.06
    sorted              true
    renderer        billboard

    emitter Box {
        position 0 -0.4 0
        direction 0 1 0
        angle 45 
        duration 0
        emission_rate 1  
        time_to_live_min 5.0
        time_to_live_max 10.0
        width  2.5
        height 1
        depth  2.5
        velocity_min 0.01
        velocity_max 0.1
    }
    
    affector ColourImage
	{
		image particle_ritual.png
	}
}

particle_system Particle/Star
{
    billboard_type      point
    particle_width      1
    particle_height     1
    quota               100
    sorted              true

    emitter Point {
        position 0 0 0
        direction 0 1 0
        angle 60 
        duration 0
        emission_rate 60  
        time_to_live_min 2.0
        time_to_live_max 4.0

        velocity_min 1
        velocity_max 5
    }
}