
particle_system Particle/Star
{
    billboard_type      point
    particle_width      0.25
    particle_height     0.25
    quota               10
    sorted              true

    emitter Point {
        position 0 -0.05 0
        direction 0 1 0
        angle 60 
        colour 0.0 0.0 1.0 1.0
        duration 0
        emission_rate 3  
        time_to_live_min 1.0
        time_to_live_max 2.0
        velocity_min 0.2
        velocity_max 1.0
    }
    affector ColourFader
    {
        red -0.05
        green -0.05
        blue -0.02
        alpha -0.01
    }
}

particle_system Particle/StarRndColor
{
    billboard_type      point
    particle_width      0.1
    particle_height     0.1
    quota               10
    sorted              true

    emitter Point {
        position 0 -0.05 0
        direction 0 1 0
        angle 60 
        duration 0
        emission_rate 3  
        time_to_live_min 1.0
        time_to_live_max 2.0
        velocity_min 0.2
        velocity_max 1.0
        colour_range_start 1.0 0.4 0.0 1.0
        colour_range_end   1.0 1.0 0.0 1.0
    }
    affector ColourFader
    {
        red -0.05
        green -0.05
        blue -0.02
        alpha -0.01
    }
}

particle_system Particle/Smoke
{
    billboard_type      point
    particle_width      0.5
    particle_height     0.5
    quota               30
    sorted              true

    emitter Point {
        position 0 -0.05 -0.5
        direction 0 1 0
        angle 30
        colour 1.0 1.0 1.0 1.0
        duration 0
        emission_rate 3  
        time_to_live_min 5.0
        time_to_live_max 10.0
        velocity_min 0.2
        velocity_max 1.0
    }
    affector ColourFader
    {
        red -0.05
        green -0.05
        blue -0.02
        alpha -0.01
    }
    affector Scaler
    {
        rate 0.5
    }
}