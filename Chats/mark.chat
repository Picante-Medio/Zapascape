PREFAB mark
ENTITY mark 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 -100.0 0.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 0.65 0.65 0.65
    COMPONENT RenderComponent
        STRING meshName mark.glb
        STRING materialName 
    COMPONENT ParticleEmitterComponent
        STRING particleName Particle/Star
        STRING material Particle/ImageMaterial
        INT quota 50
        BOOL sorted true
        VECTOR_3 direction 0.0 1.0 0.0
        FLOAT emissionRate 20.0
        FLOAT timeToLive 0.5
        FLOAT velocityMin 5.0
        FLOAT velocityMax 10.0
        VECTOR_4 colour 0.0 0.0 1.0 1.0
        FLOAT duration 1.0
        FLOAT width 0.025
        FLOAT height 0.025
        BOOL emitting true
        BOOL active true
    START_CHILDREN
    END_CHILDREN
END_ENTITY

