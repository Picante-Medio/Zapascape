PREFAB tuxStatic
ENTITY tuxStatic 1
    COMPONENT TransformComponent
      VECTOR_3 position -1.5 -0.5 -2.0
      QUATERNION rotation 0.0 0.0 0.0 1.0
      VECTOR_3 scale 0.2 0.2 0.2
    COMPONENT RenderComponent
      STRING meshName tuxSinZapas.mesh
      STRING materialName
    START_CHILDREN
    END_CHILDREN
END_ENTITY