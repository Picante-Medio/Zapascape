SCENE Game
SYSTEM AudioSystem
SYSTEM RenderSystem
SYSTEM LightSystem
SYSTEM CameraSystem
SYSTEM UISystem
SYSTEM ConsoleSystem
SYSTEM HierarchySystem
SYSTEM ParticleSystem
SYSTEM GameToOtherSystem
SYSTEM MapSystem
SYSTEM PlayerInputSystem
SYSTEM MovementSystem
SYSTEM MarkSystem
SYSTEM TimeSystem
SYSTEM HUDSystem
SYSTEM RitualSystem
SYSTEM BeastieSystem
SYSTEM LuaFunctionsSystem
ENTITY Map 0
	COMPONENT MapComponent
		FLOAT gridSize 5.0
		INT numberOfRooms 100
		STRING wallPrefab wall
		INT mapWidth 500
		INT mapHeight 500
		INT numRituals 4
	COMPONENT AudioComponent
        STRING audioName game
        FLOAT volume 0.1
        BOOL loop true
        FLOAT pitch 1.0
        FLOAT startTime 0.0
        BOOL isPlaying true
		INT type 2
	COMPONENT MarkComponent
		int maxNum 10
	START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY Timer 1
	COMPONENT PanelComponent
		STRING overlayName Game/Timer/Overlay
		STRING containerName Game/Timer/Overlay/Container
		BOOL isVisible true
		INT metricsMode 0
		FLOAT left 0.0
		FLOAT top 0.0
		FLOAT width 0.0
		FLOAT height 0.0
		STRING material 
	COMPONENT TextComponent
		STRING textAreaName Game/Timer/Overlay/Container/Text
		STRING text SDHIDHHA
		STRING textFont Roboto
		FLOAT characterHeight 0.05
		FLOAT spaceWidth 0.01
		VECTOR_4 colour 0.0 0.0 0.0 0.0
		VECTOR_4 colourTop 0.80000001192093 0.75300002098083 0.34900000691414 1.0
		VECTOR_4 colourBottom 0.80000001192093 0.75300002098083 0.34900000691414 1.0
		FLOAT left 0.5
		FLOAT top 0.05
		FLOAT maxWidth 1.0
		FLOAT maxHeight 1.0
	COMPONENT TimeComponent
		INT maxStopTime 10
		INT maxGameTime 180
	COMPONENT AudioComponent
        STRING audioName breath
        FLOAT volume 0.35
        BOOL loop true
        FLOAT pitch 0.7
        FLOAT startTime 0.0
        BOOL isPlaying true
		INT type 0
	START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY alert 1
	COMPONENT PanelComponent
		STRING overlayName Game/Timer/alert
		STRING containerName Game/Timer/alert/Container
		BOOL isVisible false
		INT metricsMode 0
		FLOAT left 0.0
		FLOAT top 0.0
		FLOAT width 1.0
		FLOAT height 1.0
		STRING material Game/Alert
	COMPONENT AlertTag
	START_CHILDREN
    END_CHILDREN
END_ENTITY


