PREFAB startButton
ENTITY button 0
    COMPONENT PanelComponent
        STRING overlayName Intro/StartB/Overlay
        STRING containerName Intro/StartB/Overlay/Container
        BOOL isVisible true
        INT metricsMode 0
        FLOAT left 0.45
        FLOAT top 0.6
        FLOAT width 0.15
        FLOAT height 0.1
        STRING material Intro/StartButton
    COMPONENT ButtonComponent
        STRING normalMaterial Intro/StartButton
        STRING hoverMaterial Intro/StartButtonOnHover
        STRING pressedMaterial Intro/StartButtonOnHover
        STRING disabledMaterial 
    COMPONENT AudioComponent
        STRING audioName click
        FLOAT volume 0.8
        BOOL loop false
        FLOAT pitch 0.0
        FLOAT startTime 0.0
        BOOL isPlaying false
		INT type 0
    START_CHILDREN
    END_CHILDREN
END_ENTITY