PREFAB ritual
ENTITY ritual 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 0.0 0.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT RenderComponent
        STRING meshName ritual.glb
        STRING materialName 
    COMPONENT ColliderComponent
        COLLIDER_INFO info BOX_COLLIDER 0.6 0.6 0.6
        FLOAT restitution 0.0
        FLOAT friction 0.8
        VECTOR_3 positionOffset 0.0 0.3 0.0
        QUATERNION rotationOffset 0.0 0.0 0.0 1.0
        BOOL active true
        BOOL useGizmo true
    COMPONENT ParticleEmitterComponent
        STRING particleName Particle/RitualParticle
        INT quota 200
        BOOL sorted false
        VECTOR_3 direction 0.0 1.0 0.0
        FLOAT emissionRate 10.0
        FLOAT timeToLive 0.5
        FLOAT velocityMin 5.0
        FLOAT velocityMax 10.0
        VECTOR_4 colour 1.0 0.0 0.0 1.0
        FLOAT duration 1.0
        STRING material 
        FLOAT width 0.01
        FLOAT height 0.01
        BOOL emitting true
        BOOL active true
    START_CHILDREN
    END_CHILDREN
END_ENTITY

