PREFAB beastie
ENTITY beastie 0
	COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.0 100.0
		QUATERNION rotation 0.0 1.0 0.0 0.0
		VECTOR_3 scale 0.7 0.7 0.7
    COMPONENT RenderComponent
		STRING meshName beastie.mesh
		STRING materialName 
    COMPONENT ColliderComponent
        COLLIDER_INFO info BOX_COLLIDER 0.7 0.7 0.7
        FLOAT restitution 0.0
        FLOAT friction 1.0
        VECTOR_3 positionOffset 0.0 0.72 0.0
        QUATERNION rotationOffset 0.0 0.0 0.0 1.0
        BOOL active true
        BOOL useGizmo true
    COMPONENT RigidBodyComponent
        FLOAT mass 5.0
        FLOAT linearDamping 0.4
        FLOAT angularDamping 0.0
        VECTOR_3 linearVelocity 0.0 0.0 0.0
        VECTOR_3 angularVelocity 0.0 0.0 0.0
		VECTOR_3 gravity 0.0 -2.0 0.0
        FLOAT linearSleepingThreshold 0.8
        FLOAT angularSleepingThreshold 1.0
    COMPONENT AnimationComponent
    COMPONENT MovementRBComponent
    COMPONENT BeastieComponent
        FLOAT normalForce 15.0
        FLOAT fastForce 30.0
        FLOAT slowForce 10.0
        FLOAT minRange 10.0
        FLOAT maxRange 15.0
    COMPONENT AudioComponent
        STRING audioName beastie_walk
        FLOAT volume 1.5
        BOOL loop true
        FLOAT pitch 1.0
        FLOAT startTime 0.0
        BOOL isPlaying false
		INT type 1
    COMPONENT Audio3DInfoComponent
        FLOAT maxDistance 30.0
        FLOAT minDistance 10.0
    START_CHILDREN
    END_CHILDREN
END_ENTITY

