PREFAB player
ENTITY player 1
	COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.0 0.0
		QUATERNION rotation 0.0 0.0 0.0 1.0
		VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT PlayerComponent
    COMPONENT AudioListenerComponent
        FLOAT masterVolume 3.0
    COMPONENT MovementRBComponent
        FLOAT force 25.0
    COMPONENT ColliderComponent
        COLLIDER_INFO info BOX_COLLIDER 0.6 1.5 0.6
        FLOAT restitution 0.0
        FLOAT friction 0.9
        VECTOR_3 positionOffset 0.0 0.2 0.0
        QUATERNION rotationOffset 0.0 0.0 0.0 1.0
        BOOL active true
        BOOL useGizmo false
    COMPONENT RigidBodyComponent
        FLOAT mass 5.0
        FLOAT linearDamping 0.95
        FLOAT angularDamping 0.0
        VECTOR_3 linearVelocity 0.0 0.0 0.0
        VECTOR_3 angularVelocity 0.0 0.0 0.0
		VECTOR_3 gravity 0.0 0.0 0.0
        FLOAT linearSleepingThreshold 0.8
        FLOAT angularSleepingThreshold 1.0
        BOOL dontRotateWithPhysicsOnDynamic false
        INT type 0
    COMPONENT RenderComponent
        STRING meshName player.mesh
        STRING materialName 
    COMPONENT AnimationComponent
    COMPONENT AudioComponent
        STRING audioName walk
        FLOAT volume 0.75
        BOOL loop true
        FLOAT pitch 1.25
        BOOL isPlaying false
    COMPONENT AudioListenerComponent
    COMPONENT CameraComponent
        INT projectionType 0
        FLOAT fovY 60.0
        FLOAT nearClip 0.001
        FLOAT farClip 1000.0
        FLOAT orthoWidth 10.0
        FLOAT orthoHeight 10.0
        BOOL autoAspectRatio true
        BOOL mainCamera true
        VECTOR_4 clearColor 0.0 0.0 0.1 1.0
    COMPONENT LightComponent
        VECTOR_4 diffuse 0.5 0.45 0.4 1.0 
        VECTOR_4 specular 0.5 0.5 0.5 1.0
        INT lightType 1
        FLOAT spotFalloff 1.0
        FLOAT spotNearClip 0.2
        FLOAT spotOuter 2.0
        FLOAT spotInner 1.0
        FLOAT shadowFarDist 25.0
        FLOAT shadowFarDistSquared 1.0
        VECTOR_4 attenuation 1.0 0.0 0.00999999977648 20.0
        FLOAT shadowNearClipDist 0.1
        FLOAT shadowFarClipDist 10.0
    START_CHILDREN
    END_CHILDREN
END_ENTITY

