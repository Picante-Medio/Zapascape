SCENE MainScene
SYSTEM ConsoleSystem
SYSTEM AudioSystem
SYSTEM PhysicsGizmoSystem
SYSTEM HierarchySystem
SYSTEM ParticleSystem
SYSTEM CameraSystem
SYSTEM LightSystem
SYSTEM RenderSystem
SYSTEM TweenSystem
SYSTEM UISystem
SYSTEM PlayerInputSystem
SYSTEM MovementSystem
SYSTEM MarkSystem

ENTITY camera 0
	COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.0 0.0
		QUATERNION rotation 0.0 0.0 0.0 1.0
		VECTOR_3 scale 1.0 1.0 1.0
	COMPONENT CameraComponent
		INT projectionType 0
		FLOAT fovY 60.0
		FLOAT nearClip 0.01
		FLOAT farClip 1000.0
		FLOAT orthoWidth 10.0
		FLOAT orthoHeight 10.0
		BOOL autoAspectRatio true
		BOOL mainCamera true
		VECTOR_4 clearColor 0.30000001192093 0.30000001192093 0.5 1.0

ENTITY player 1
	COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.0 0.0
		QUATERNION rotation 0.0 1.0 0.0 -0.00000004371139
		VECTOR_3 scale 1.0 1.0 1.0
	COMPONENT RenderComponent
		STRING meshName player.mesh
		STRING materialName 
		INT objectID 0
	COMPONENT PlayerComponent
	COMPONENT MovementRBComponent
		FLOAT force 25.0
	COMPONENT ColliderComponent
		INT info 0
		VECTOR_3 halfExtents 1.0 1.0 1.0
		FLOAT restitution 0.0
		FLOAT friction 0.5
		VECTOR_3 positionOffset 0.0 1.0 0.0
		QUATERNION rotationOffset 0.0 0.0 0.0 1.0
		BOOL active false
		BOOL useGizmo false
	COMPONENT RigidBodyComponent
		FLOAT mass 5.0
		FLOAT linearDamping 0.95
		FLOAT angularDamping 0.0
		VECTOR_3 linearVelocity 0.0 0.0 0.0
		VECTOR_3 angularVelocity 0.0 0.0 0.0
		FLOAT linearSleepingThreshold 0.0
		FLOAT angularSleepingThreshold 0.0

ENTITY Beastie 2
	COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.0 5.0
		QUATERNION rotation 0.0 0.0 0.0 1.0
		VECTOR_3 scale 0.40000000596046 0.40000000596046 0.40000000596046
	COMPONENT RenderComponent
		STRING meshName beastie.mesh
		STRING materialName 
		INT objectID 0
	COMPONENT AnimationComponent

