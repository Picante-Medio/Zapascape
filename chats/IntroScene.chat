SCENE IntroScene
SYSTEM AudioSystem
SYSTEM TransformSystem
SYSTEM ParticleSystem
SYSTEM CameraSystem
SYSTEM LightSystem
SYSTEM RenderSystem
SYSTEM TweenSystem
SYSTEM UISystem
SYSTEM InstantiateButtonSystem
SYSTEM IntroToGameSystem

ENTITY camera 1
    COMPONENT TransformComponent
        VECTOR_3 position 0.0 0.0 0.0
        QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
    COMPONENT CameraComponent
        INT projectionType 0
        FLOAT fovY 60.0
        FLOAT nearClip 1.0
        FLOAT farClip 10000.0
        FLOAT orthoWidth 10.0
        FLOAT orthoHeight 10.0
        BOOL autoAspectRatio true
        BOOL mainCamera true
        VECTOR_4 clearColor 0.30000001192093 0.30000001192093 0.5 1.0
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY background 1
    COMPONENT TransformComponent
		VECTOR_3 position 0.0 0.0 -10.0
		QUATERNION rotation 0.0 1.0 0.0 0.0
		VECTOR_3 scale 32.0 18.0 0.1
    COMPONENT RenderComponent
		STRING meshName cube.mesh
		STRING materialName Intro/Background
    COMPONENT AudioComponent
        STRING audioName intro
        FLOAT volume 0.4
        BOOL loop true
        FLOAT pitch 0.0
        FLOAT startTime 0.0
        BOOL isPlaying true
		INT type 2
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY Text 1
    COMPONENT PanelComponent
        STRING overlayName adsdad
        STRING containerName dsadfefwf
        BOOL isVisible true
        INT metricsMode 0
        FLOAT left 0.0
        FLOAT top 0.0
        FLOAT width 0.0
        FLOAT height 0.0
        STRING material 
    COMPONENT TextComponent
        STRING textAreaName untexto
        STRING text ZAPASCAPE
        STRING textFont RubikGlitch
        FLOAT characterHeight 0.25
        FLOAT spaceWidth 0.005
        VECTOR_4 colour 0.0 0.0 0.0 0.0
        VECTOR_4 colourTop 0.4 0.03500000014901 0.03500000014901 1.0
        VECTOR_4 colourBottom 0.1 0.05 0.05 1.0
        FLOAT left 0.15
        FLOAT top 0.1
        FLOAT maxWidth 0.0
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY zapas 1
	COMPONENT TransformComponent
        VECTOR_3 position 0.0 -1.2 -2.5
		QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 2.2 2.2 2.2
    COMPONENT RenderComponent
		STRING meshName zapatos.mesh
		STRING materialName 
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY luz 1
	COMPONENT TransformComponent
        VECTOR_3 position 0.0 -1.2 -0.5
		QUATERNION rotation 0.0 0.0 0.0 1.0
        VECTOR_3 scale 1.0 1.0 1.0
     COMPONENT LightComponent
        VECTOR_4 diffuse 0.8 0.2 0.2 1.0
        VECTOR_4 specular 0.5 0.5 0.5 1.0
        INT lightType 2
        FLOAT spotFalloff 1.0
        FLOAT spotNearClip 0.2
        FLOAT spotOuter 0.610865235
        FLOAT spotInner 0.1004
        FLOAT shadowFarDist 20.0
        FLOAT shadowFarDistSquared 1.0
        VECTOR_4 attenuation 1.0 0.0 0.00999999977648 20.0
        FLOAT shadowNearClipDist 0.1
        FLOAT shadowFarClipDist 300.0
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY pass 1
    COMPONENT AudioComponent 
        STRING audioName click
        FLOAT volume 0.75
        BOOL loop false
        FLOAT pitch 0.0
        FLOAT startTime 0.0
        BOOL isPlaying false
        INT type 0
    COMPONENT ClickTag
    START_CHILDREN
    END_CHILDREN
END_ENTITY

ENTITY Loading 1
    COMPONENT PanelComponent
        STRING overlayName safaf
        STRING containerName geywrwysf
        BOOL isVisible false
        INT metricsMode 0
        FLOAT left 0.0
        FLOAT top 0.0
        FLOAT width 1.0
        FLOAT height 1.0
        STRING material Intro/Loading
        INT zOrder 600
    START_CHILDREN
    END_CHILDREN
END_ENTITY