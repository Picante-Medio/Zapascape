material colorFloor
{
    receive_shadows on
    technique {
        pass {
            texture_unit {
                texture floor_texture.png
                tex_address_mode wrap
                scale 0.005 0.005
            }
        }
    }
}

material colorTecho
{
    receive_shadows on
    technique {
        pass {
            lighting on
            scene_blend add
            depth_write on
            texture_unit {
                texture ceiling.png
                tex_address_mode wrap
                scale 0.005 0.005
            }
        }
    }
}

material luzTecho
{
    receive_shadows on
    technique {
        pass {
            lighting on
            scene_blend add
            depth_write on
            texture_unit {
                texture light.jpg
                tex_address_mode wrap
            }
        }
    }
}

material Particle/ImageMaterial
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            depth_check on

            texture_unit
            {
                texture particle_ritual.png
            }
        }
    }
}

material Particle/Particle/MarkMaterial
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            depth_check on

            texture_unit
            {
                texture particle_mark.png
            }
        }
    }
}

material Door/FiltroRojo
{
    technique 
	{
		pass 
		{
            ambient 0.16 0.02 0.02 1.00
            diffuse 0.25 0.25 0.25 1.00
            specular 0.5 0.0 0.0 8
            emissive 0.0 0.0 0.0
		}
    }
}

material static/Star
{
    technique {
        pass {
            lighting off
            scene_blend alpha_blend
            depth_write off   
            diffuse vertexcolour
            texture_unit {
                texture star.png
            }
        }
    }   
}

material static/Smoke
{
    technique {
        pass {
            lighting off
            scene_blend alpha_blend
            depth_write off   
            diffuse vertexcolour
            texture_unit {
                texture smoke.png
            }
        }
    }   
}