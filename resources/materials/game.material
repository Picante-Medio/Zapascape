material colorFloor
{
    receive_shadows on
    technique
    {
        pass
        {
            rtshader_system
            {
                lighting_stage per_pixel
            }
            lighting on
            ambient 0.3 0.3 0.3 1.0
            diffuse 0.6 0.6 0.6 1.0
            specular 0.02 0.02 0.02 1.0
            shininess 64.0
            emissive 0.0 0.0 0.0 1.0
            
            texture_unit
            {
                texture floor_texture.png
                tex_address_mode wrap
                scale 0.005 0.005
            }
        }
    }
}

material colorTecho
{
    receive_shadows on
    technique
    {
        pass
        {
            rtshader_system
            {
                lighting_stage per_pixel
            }
            
            lighting on
            ambient 0.25 0.25 0.25 1.0
            diffuse 0.5 0.5 0.5 1.0
            specular 0.01 0.01 0.01 1.0
            shininess 32.0
            emissive 0.0 0.0 0.0 1.0
            
            texture_unit
            {
                texture ceiling.png
                tex_address_mode wrap
                scale 0.005 0.005
            }
        }
    }
}

material luzTecho
{
    receive_shadows on
    technique {
        pass {
            lighting on
            scene_blend add
            depth_write on
            texture_unit {
                texture light.jpg
                tex_address_mode wrap
            }
        }
    }
}

material Particle/ImageMaterial
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            depth_check on

            texture_unit
            {
                texture particle_ritual.png
            }
        }
    }
}

material Particle/Particle/MarkMaterial
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            depth_check on

            texture_unit
            {
                texture particle_mark.png
            }
        }
    }
}

material Door/FiltroRojo
{
    technique 
	{
		pass 
		{
            ambient 0.16 0.02 0.02 1.00
            diffuse 0.25 0.25 0.25 1.00
            specular 0.5 0.0 0.0 8
            emissive 0.0 0.0 0.0
		}
    }
}

material static/Star
{
    technique {
        pass {
            lighting off
            scene_blend alpha_blend
            depth_write off   
            diffuse vertexcolour
            texture_unit {
                texture star.png
            }
        }
    }   
}

material static/Smoke
{
    technique {
        pass {
            lighting off
            scene_blend alpha_blend
            depth_write off   
            diffuse vertexcolour
            texture_unit {
                texture smoke.png
            }
        }
    }   
}

material Game/Alert
{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend

            texture_unit{
                texture alert.png
                colour_op replace
            }
        }
    }
}

material Game/Fill/Background
{
    technique
    {
        pass
        {
            // MUST BE INCLUDED
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend

            texture_unit
            {
                texture darkGray.png
                colour_op replace
            }

        }
    }
}

