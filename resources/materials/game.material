material colorFloor
{
    receive_shadows on
    technique {
        pass {
            texture_unit {
                texture floor_texture.png
                tex_address_mode wrap
                scale 0.005 0.005
            }
        }
    }
}

material colorTecho
{
    receive_shadows on
    technique {
        pass {
            lighting on
            scene_blend add
            depth_write on
            texture_unit {
                texture ceiling.png
                tex_address_mode wrap
                scale 0.005 0.005
            }
        }
    }
}

material Particle/ImageMaterial
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off

            texture_unit
            {
                texture particle_ritual.png 
            }
        }
    }
}